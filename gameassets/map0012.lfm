(level "map0012"
  (version 2)
  (title "Centipede")
  (tags "stage" "boss")
  (size 2000 2000)
  (music "music/Midnight_Override.mp3")
  (player-start 1000 1850 -90)
  (entry "enter" 1000 1850 -90)
  ; A swarm and a tank at the heart of it. The tank is shielded until the swarm is cleared; only
  ; then does the way onward open. Two columns of cover break the field.
  (wall "walls"
    (stroke "#ff8060") (width 3) (fill "transparent") (glow 1.0)
    (rect 60 60 1880 1880)
    (rect 520 640 60 720)
    (rect 1420 640 60 720))
  (spawn "boss" "tank" 1000 460 -90 (kind "tank") (boss))
  (spawn "rusher_1" "rusher" 760 760 -90 (kind "rusher"))
  (spawn "rusher_2" "rusher" 1240 760 -90 (kind "rusher"))
  (spawn "rusher_3" "rusher" 760 1240 90 (kind "rusher"))
  (spawn "rusher_4" "rusher" 1240 1240 90 (kind "rusher"))
  (spawn "rusher_5" "rusher" 1000 1000 -90 (kind "rusher"))
  (spawn "enemy_1" "enemy" 300 900 0 (kind "enemy"))
  (spawn "enemy_2" "enemy" 1700 900 180 (kind "enemy"))
  (spawn "sniper_1" "sniper" 300 460 0 (kind "sniper"))
  (spawn "sniper_2" "sniper" 1700 460 180 (kind "sniper"))
  (spawn "heal_1" "powerup" 1000 1650 0 (kind "heal"))
  (spawn "bubble_1" "bubblepower" 300 1650 0 (kind "bubble"))
  (zone "checkpoint_1" "circle" 1000 1780 70 (trigger "checkpoint"))
  (resolution "cleared" "portal" (target "map0013") (at 1000 240))
  (editor (snap) (snap-radius 8) (grid) (grid-size 20) (snap-to-grid))
)
