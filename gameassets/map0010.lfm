(level "map0010"
  (version 2)
  (title "Bosconian")
  (tags "stage")
  (size 2000 2000)
  (music "music/Eight_Left_Standing.mp3")
  (player-start 1000 1850 -90)
  (entry "enter" 1000 1850 -90)
  ; Four corner nests and a core, each a block ringed by turrets. Clear every turret to advance —
  ; the blocks are cover the turrets hide behind, so you have to circle in.
  (wall "walls"
    (stroke "#80ffff") (width 2) (fill "transparent") (glow 0.8)
    (rect 60 60 1880 1880)
    (rect 400 400 160 160)
    (rect 1440 400 160 160)
    (rect 400 1440 160 160)
    (rect 1440 1440 160 160)
    (rect 920 920 160 160))
  (spawn "turret_1" "turret" 320 480 0 (kind "turret"))
  (spawn "turret_2" "turret" 480 320 90 (kind "turret"))
  (spawn "turret_3" "turret" 1680 480 180 (kind "turret"))
  (spawn "turret_4" "turret" 1520 320 90 (kind "turret"))
  (spawn "turret_5" "turret" 320 1520 0 (kind "turret"))
  (spawn "turret_6" "turret" 480 1680 -90 (kind "turret"))
  (spawn "turret_7" "turret" 1680 1520 180 (kind "turret"))
  (spawn "turret_8" "turret" 1520 1680 -90 (kind "turret"))
  (spawn "rusher_1" "rusher" 1000 700 -90 (kind "rusher"))
  (spawn "rusher_2" "rusher" 1000 1300 90 (kind "rusher"))
  (spawn "heal_1" "powerup" 1000 1700 0 (kind "heal"))
  (spawn "damage_1" "damagepower" 1000 300 0 (kind "damage"))
  (spawn "portal_next" "portal" 1000 160 0 (kind "portal") (target "map0011"))
  (editor (snap) (snap-radius 8) (grid) (grid-size 20) (snap-to-grid))
)
