(asset "bubblepower"
  (version 2)
  (kind "bubble")
  (tags "powerup" "bubble")
  (size 24 24)
  (origin 12 12)
  (layer "main"
    (stroke "#80f0ff") (width 2) (fill "transparent") (glow 0.9)
    (path (move 12 3) (line 18 6) (line 21 12) (line 18 18) (line 12 21) (line 6 18) (line 3 12) (line 6 6) (close))
    (path (move 12 8) (line 15 10) (line 16 12) (line 15 14) (line 12 16) (line 9 14) (line 8 12) (line 9 10) (close)))
  (collision "circle" 12 12 16)
  (editor (snap) (snap-radius 8) (grid) (grid-size 4))
)
