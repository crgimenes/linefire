(level "map0013"
  (version 2)
  (title "Pac-Man")
  (tags "stage")
  (size 2200 2200)
  (music "music/Eight_Left_Standing.mp3")
  (player-start 1000 1980 -90)
  (entry "enter" 1000 1980 -90)
  ; A grid maze of nine blocks with corridors between them and a lane around the rim. Rushers are
  ; the ghosts, hunting you through the halls; the pickups are the pellets.
  (wall "walls"
    (stroke "#80ffff") (width 2) (fill "transparent") (glow 0.8)
    (rect 60 60 2080 2080)
    (rect 340 340 360 360)
    (rect 920 340 360 360)
    (rect 1500 340 360 360)
    (rect 340 920 360 360)
    (rect 920 920 360 360)
    (rect 1500 920 360 360)
    (rect 340 1500 360 360)
    (rect 920 1500 360 360)
    (rect 1500 1500 360 360))
  (spawn "rusher_1" "rusher" 810 810 0 (kind "rusher"))
  (spawn "rusher_2" "rusher" 1390 810 180 (kind "rusher"))
  (spawn "rusher_3" "rusher" 810 1390 0 (kind "rusher"))
  (spawn "rusher_4" "rusher" 1390 1390 180 (kind "rusher"))
  (spawn "rusher_5" "rusher" 1100 200 -90 (kind "rusher"))
  (spawn "heal_1" "powerup" 2000 1100 0 (kind "heal"))
  (spawn "fire_1" "firepower" 200 1100 0 (kind "fire"))
  (spawn "rate_1" "ratepower" 1100 2000 0 (kind "rate"))
  (spawn "portal_next" "portal" 1000 180 0 (kind "portal") (target "map0014"))
  (editor (snap) (snap-radius 8) (grid) (grid-size 20) (snap-to-grid))
)
