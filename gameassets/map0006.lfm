(level "map0006"
  (version 2)
  (title "Asteroids")
  (tags "stage")
  (size 1900 1900)
  (music "music/Midnight_Override.mp3")
  (player-start 950 1740 -90)
  (entry "enter" 950 1740 -90)
  ; An open field strewn with destructible-rock asteroids (circles): the enemies drift in the gaps,
  ; but the rock is diggable, so a laser or missiles can carve straight lines through it.
  (wall "walls"
    (stroke "#80ffff") (width 2) (fill "transparent") (glow 0.8)
    (rect 60 60 1780 1780)
    (circle 500 520 140)
    (circle 1350 480 120)
    (circle 950 950 170)
    (circle 480 1350 130)
    (circle 1400 1350 150)
    (circle 600 320 90))
  (spawn "enemy_1" "enemy" 1650 300 -90 (kind "enemy"))
  (spawn "enemy_2" "enemy" 250 900 0 (kind "enemy"))
  (spawn "rusher_1" "rusher" 950 1550 -90 (kind "rusher"))
  (spawn "sniper_1" "sniper" 1650 1650 -90 (kind "sniper"))
  (spawn "tank_1" "tank" 1550 950 180 (kind "tank"))
  (spawn "enemy_3" "enemy" 300 300 0 (kind "enemy"))
  (spawn "heal_1" "powerup" 950 1600 0 (kind "heal"))
  (spawn "shield_1" "shield" 300 1650 0 (kind "shield"))
  (spawn "portal_next" "portal" 950 180 0 (kind "portal") (target "map0007"))
  (editor (snap) (snap-radius 8) (grid) (grid-size 20) (snap-to-grid))
)
