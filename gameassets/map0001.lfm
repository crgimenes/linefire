(level "map0001"
  (version 2)
  (title "Star Raiders")
  (tags "stage")
  (size 1200 1000)
  (music "music/One_Heart_Remaining.mp3")
  (player-start 600 500 -90)
  (entry "from_map2" 600 300 -90)
  (entry "from_bonus" 600 500 -90)
  (wall "walls"
    (stroke "#80ffff") (width 2) (fill "transparent") (glow 0.8)
    (path (move 40 -1120) (line 1360 -780) (line 1160 1380) (line 40 1340) (close))
    (path (move 200 200) (line 520 200) (line 520 420) (line 200 420) (close))
    (path (move 680 200) (line 1000 200) (line 1000 420) (line 680 420) (close))
    (path (move 200 580) (line 520 580) (line 520 800) (line 200 800) (close))
    (path (move 680 800) (line 680 580))
    (path (move 320 -680) (line 580 -720) (line 780 -660) (line 1040 -660) (line 1180 -600) (line 1140 -460) (line 1020 -520) (line 800 -520) (line 560 -600) (line 340 -560) (close))
    (path (move 340 -340) (line 500 -220) (line 880 -200) (line 1100 -280) (line 1160 -160) (line 920 -40) (line 700 -100) (line 480 -60) (line 260 -240) (close))
    (path (move 680 580) (line 1000 580) (line 1000 800) (line 900 800) (line 900 720) (line 780 720) (line 780 800) (line 680 800)))
  (spawn "turret_1" "turret" 360 110 90 (kind "turret"))
  (spawn "enemy_2" "enemy" 840 110 90 (kind "enemy"))
  (spawn "enemy_3" "enemy" 110 680 0 (kind "enemy"))
  (spawn "rusher_4" "rusher" 1090 320 180 (kind "rusher"))
  (spawn "sniper_5" "sniper" 600 880 -90 (kind "sniper"))
  (spawn "enemy_6" "enemy" 260 -920 -90 (kind "enemy"))
  (spawn "enemy_7" "enemy" 880 -780 -90 (kind "enemy"))
  (spawn "tank_8" "tank" 700 -360 -90 (kind "tank"))
  (spawn "heal_1" "powerup" 600 300 0 (kind "heal"))
  (spawn "shield_1" "shield" 600 700 0 (kind "shield"))
  (spawn "portal_next" "portal" 700 80 0 (kind "portal") (target "map0004:from_map1"))
  (spawn "portal_bonus" "portal" 300 500 0 (kind "portal") (target "@bonus"))
  (spawn "wpn_laser_1" "wpn_laser" 480 500 0 (kind "weapon-laser"))
  (spawn "wpn_missile_1" "wpn_missile" 720 500 0 (kind "weapon-missile"))
  (spawn "wpn_devourer_1" "wpn_devourer" 600 200 0 (kind "weapon-devourer"))
  (spawn "computer_1" "computer" 600 640 0 (kind "computer"))
  (spawn "fire_1" "firepower" 600 360 0 (kind "fire"))
  (spawn "rate_1" "ratepower" 540 360 0 (kind "rate"))
  (spawn "damage_1" "damagepower" 660 360 0 (kind "damage"))
  (spawn "ally_1" "allypower" 540 300 0 (kind "ally"))
  (spawn "drone_1" "dronepower" 660 300 0 (kind "drone"))
  (spawn "bubble_1" "bubblepower" 540 760 0 (kind "bubble"))
  (spawn "reflect_1" "reflectpower" 660 760 0 (kind "reflect"))
  (spawn "seek_1" "seekpower" 600 420 0 (kind "seek"))
  (spawn "tank_25" "tank" 840 760 -90 (kind "tank"))
  (zone "exit" "circle" 600 800 60 (trigger "exit"))
  (zone "checkpoint_1" "circle" 600 600 70 (trigger "checkpoint"))
  (resolution "cleared" "spawn" (target "shield") (at 600 420))
  (editor (snap) (snap-radius 8) (grid) (grid-size 20) (snap-to-grid))
)
