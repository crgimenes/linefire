(level "map0015"
  (version 2)
  (title "Xevious")
  (tags "stage")
  (size 1600 2800)
  (music "music/Eight_Left_Standing.mp3")
  (player-start 800 2620 -90)
  (entry "enter" 800 2620 -90)
  ; A straight climb past dug-in ground turrets on alternating ledges while rushers dive in from
  ; above — you pick off the emplacements between dodging the divers.
  (wall "walls"
    (stroke "#80ffff") (width 2) (fill "transparent") (glow 0.8)
    (rect 50 50 1500 2700)
    (rect 50 2200 400 60)
    (rect 1100 1800 400 60)
    (rect 50 1400 400 60)
    (rect 1100 1000 400 60)
    (rect 50 600 400 60))
  (spawn "turret_1" "turret" 250 2100 90 (kind "turret"))
  (spawn "turret_2" "turret" 1300 1700 -90 (kind "turret"))
  (spawn "turret_3" "turret" 250 1300 90 (kind "turret"))
  (spawn "turret_4" "turret" 1300 900 -90 (kind "turret"))
  (spawn "turret_5" "turret" 250 500 90 (kind "turret"))
  (spawn "rusher_1" "rusher" 800 1900 -90 (kind "rusher"))
  (spawn "rusher_2" "rusher" 800 1100 -90 (kind "rusher"))
  (spawn "heal_1" "powerup" 800 2450 0 (kind "heal"))
  (spawn "damage_1" "damagepower" 800 300 0 (kind "damage"))
  (spawn "portal_next" "portal" 800 160 0 (kind "portal") (target "map0016"))
  (horde (types "rusher") (interval 60) (max-alive 8) (ramp 540) (seed 14))
  (editor (snap) (snap-radius 8) (grid) (grid-size 20) (snap-to-grid))
)
