(level "map0016"
  (version 2)
  (title "Gorf")
  (tags "stage")
  (size 2200 2200)
  (music "music/Midnight_Override.mp3")
  (player-start 1100 2040 -90)
  (entry "enter" 1100 2040 -90)
  ; Everything at once, right before the lair: every archetype on the field plus a trickle of
  ; reinforcements, four pillars for cover. Survive it and the finale's door is at the top.
  (wall "walls"
    (stroke "#80ffff") (width 2) (fill "transparent") (glow 0.8)
    (rect 60 60 2080 2080)
    (rect 560 560 220 220)
    (rect 1420 560 220 220)
    (rect 560 1420 220 220)
    (rect 1420 1420 220 220))
  (spawn "tank_1" "tank" 1100 400 -90 (kind "tank"))
  (spawn "turret_1" "turret" 300 300 0 (kind "turret"))
  (spawn "turret_2" "turret" 1900 300 180 (kind "turret"))
  (spawn "sniper_1" "sniper" 300 1100 0 (kind "sniper"))
  (spawn "sniper_2" "sniper" 1900 1100 180 (kind "sniper"))
  (spawn "rusher_1" "rusher" 1100 1100 -90 (kind "rusher"))
  (spawn "rusher_2" "rusher" 800 1100 -90 (kind "rusher"))
  (spawn "rusher_3" "rusher" 1400 1100 -90 (kind "rusher"))
  (spawn "enemy_1" "enemy" 300 1900 0 (kind "enemy"))
  (spawn "enemy_2" "enemy" 1900 1900 180 (kind "enemy"))
  (spawn "heal_1" "powerup" 1100 1850 0 (kind "heal"))
  (spawn "shield_1" "shield" 700 1850 0 (kind "shield"))
  (spawn "bubble_1" "bubblepower" 1500 1850 0 (kind "bubble"))
  (spawn "portal_next" "portal" 1100 200 0 (kind "portal") (target "map0003:from_map2"))
  (horde (types "enemy" "rusher") (interval 90) (max-alive 6) (ramp 600) (seed 15))
  (editor (snap) (snap-radius 8) (grid) (grid-size 20) (snap-to-grid))
)
