(level "untitled"
  (version 2)
  (size 512 512)
  (player-start 256 256 -90)
  (wall "walls"
    (stroke "#80ffff") (width 2) (fill "transparent") (glow 0.8)
    (path (move 192 192) (cubic 160 192 384 176 384 176) (line 384 384) (line 128 432) (close)))
  (editor (snap) (snap-radius 8) (grid) (grid-size 16) (snap-to-grid))
)
