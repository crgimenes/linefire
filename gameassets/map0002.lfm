(level "map0002"
  (version 2)
  (title "Robotron Siege")
  (size 1000 800)
  (music "music/Eight_Left_Standing.mp3")
  (player-start 200 400 -90)
  (entry "from_map1" 500 150 -90)
  (entry "corner" 850 650 -90)
  (wall "walls"
    (stroke "#80ffff") (width 2) (fill "transparent") (glow 0.8)
    (path (move 60 60) (line 940 60) (line 940 740) (line 60 740) (close))
    (path (move 430 330) (line 570 330) (line 570 470) (line 430 470) (close))
    (path (move 300 540) (quad 360 540 360 600) (quad 360 660 300 660) (quad 240 660 240 600) (quad 240 540 300 540) (close))
    (path (move 848 272) (cubic 624 176 752 400 752 400) (line 848 272)))
  (spawn "enemy_1" "enemy" 180 180 -90 (kind "enemy"))
  (spawn "enemy_2" "enemy" 820 620 -90 (kind "enemy"))
  (spawn "heal_1" "powerup" 820 180 0 (kind "heal"))
  (spawn "portal_back" "portal" 180 620 0 (kind "portal") (target "map0001:from_map2"))
  (spawn "portal_corner" "portal" 150 150 0 (kind "portal") (target "map0002:corner"))
  (spawn "portal_next" "portal" 850 150 0 (kind "portal") (target "map0008"))
  (zone "exit" "circle" 850 150 50 (trigger "exit"))
  (horde (types "enemy" "rusher" "sniper") (interval 50) (max-alive 10) (ramp 420) (seed 11))
  (editor (snap) (snap-radius 8) (grid) (grid-size 16) (snap-to-grid))
)
